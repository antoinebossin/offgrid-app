<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- En-tete : identite du site + acces aux reglages -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/siteName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/text"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/siteTagline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/textDim"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnSettings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:padding="8dp"
                android:text="Réglages"
                android:textColor="@color/textDim"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Premier demarrage : jamais bloquant, simplement une invitation -->
        <TextView
            android:id="@+id/banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@color/panel"
            android:padding="12dp"
            android:text="Accès non protégé — définir un mot de passe"
            android:textColor="@color/warn"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- Installation configuree : les deux gestes puis le pilotage -->
        <LinearLayout
            android:id="@+id/configuredBlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reprenez la main,\noù que vous soyez"
                android:textColor="@color/text"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/vpnHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="32dp"
                android:textColor="@color/textDim"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnOpenVpn"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="12dp"
                android:backgroundTint="@color/panel"
                android:text="1 · Ouvrir OpenVPN Connect"
                android:textAllCaps="false"
                android:textColor="@color/text" />

            <Button
                android:id="@+id/btnPilotage"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:backgroundTint="@color/accent"
                android:text="2 · Pilotage — Ouvrir la WebVisu"
                android:textAllCaps="false"
                android:textColor="@color/bg"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Aucune installation renseignee -->
        <LinearLayout
            android:id="@+id/unconfiguredBlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Installation\nnon configurée"
                android:textColor="@color/text"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="28dp"
                android:text="Indiquez l'adresse de la WebVisu de l'automate pour commencer. L'installateur vous la fournit avec le profil OpenVPN."
                android:textColor="@color/textDim"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnConfigure"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:backgroundTint="@color/accent"
                android:text="Configurer l'installation"
                android:textAllCaps="false"
                android:textColor="@color/bg"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/footer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:textColor="@color/muted"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
