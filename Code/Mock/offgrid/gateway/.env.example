# Endpoint OPC-UA du WAGO (via le tunnel OpenVPN). Ex : opc.tcp://10.8.0.1:4840
# Pour le simulateur local : opc.tcp://localhost:4840/UA/OffGrid
OPCUA_ENDPOINT=opc.tcp://localhost:4840/UA/OffGrid

# Authentification OPC-UA (laisser vide tant que le serveur accepte l'anonyme).
# A renseigner quand Francois aura cree un compte OPC-UA dedie a l'appli.
OPCUA_USER=
OPCUA_PASSWORD=

# Mettre "true" quand le WAGO exigera Sign & Encrypt (Basic256Sha256).
OPCUA_SECURE=false

PORT=3000
